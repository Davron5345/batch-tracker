# PostgreSQL (local example / Railway provides DATABASE_URL automatically)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/batch_tracker?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL used in QR codes (no trailing slash)
# On Railway: https://your-app.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protect /api/jobs/media-pipeline (YouTube upload + archive purge)
CRON_SECRET="change-me-cron-secret"

# YouTube Data API (optional). Without these, video stays on the server.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
YOUTUBE_PRIVACY_STATUS="unlisted"

# Auth.js / NextAuth trust host behind Railway proxy
AUTH_TRUST_HOST="true"
